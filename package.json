{
  "name": "leadboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/contracts",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run build --workspace=@leadboard/contracts && npm run typecheck --workspaces",
    "test": "npm run build --workspace=@leadboard/contracts && npm test --workspaces",
    "dev": "npm run build --workspace=@leadboard/contracts && concurrently -k -n contracts,backend,frontend \"npm run dev -w @leadboard/contracts\" \"npm run dev -w @leadboard/backend\" \"npm run dev -w @leadboard/frontend\"",
    "start": "npm start --workspace=@leadboard/backend",
    "dev:backend": "npm run build -w @leadboard/contracts && npm run dev -w @leadboard/backend",
    "dev:frontend": "npm run build -w @leadboard/contracts && npm run dev -w @leadboard/frontend",
    "check:integration": "node scripts/check-integration.mjs",
    "check:phase1": "node scripts/check-integration.mjs --complete",
    "test:tooling": "node --test scripts/test/*.test.mjs",
    "test:bootstrap": "node scripts/bootstrap-smoke.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:verify": "node --env-file-if-exists=.env scripts/db-verify.mjs",
    "test:db": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --root backend db-test",
    "sync:once": "node --env-file-if-exists=.env --import tsx backend/src/sync/once.ts",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --root backend --maxWorkers=1 integration-test",
    "test:pipeline": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --root backend pipeline-test/pipeline.test.ts",
    "test:e2e": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run tests/e2e/mock.test.ts",
    "test:e2e:live": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run tests/e2e/live.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "node-pg-migrate": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
