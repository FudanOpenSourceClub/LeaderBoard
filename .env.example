# GitHub
GITHUB_TOKEN=
GITHUB_ORG=
LEADBOARD_GROUP_PROPERTY=leadboard_group

# Database
DATABASE_URL=postgresql://leadboard:leadboard@localhost:5432/leadboard

# Backend
PORT=3000

# Optional during frontend development: show schema-validated demo data.
# Never enable mock mode for a production build.
# VITE_LEADBOARD_API_MODE=mock

# Ingestion
# Default: every 6 hours
INGESTION_CRON_SCHEDULE=0 */6 * * *

# First sync collects the most recent N days
INITIAL_SYNC_DAYS=30

# Incremental sync overlaps the previous successful range by N minutes.
# Idempotent upsert removes duplicates and avoids boundary misses.
SYNC_OVERLAP_MINUTES=10

# Freshness threshold
DATA_STALE_AFTER_HOURS=12


# Fudan identity verification
# 32+ random characters; used only to HMAC email/IP fingerprints.
EMAIL_HMAC_SECRET=
# Comma-separated root domains. Subdomains are also accepted.
FUDAN_EMAIL_DOMAINS=fudan.edu.cn,m.fudan.edu.cn

# Verification email sender (SMTP). Leave blank until a sender account is chosen.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
# For port 587 set SMTP_SECURE=false and SMTP_STARTTLS=true.
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# GitHub account linking (OAuth web flow)
# Register a GitHub OAuth App and set its callback URL to this exact endpoint.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# Repository review: private administrator identity and notification destination.
# Website roles are stored in PostgreSQL; initialize the first owner using scripts/website-roles.mjs.
PROJECT_REVIEW_EMAIL=swiftgorge5@gmail.com
SITE_URL=https://47.116.20.196
